{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "expo": {
    "install": {
      "//": "TypeScript is held at the workspace's 5.9 rather than the 6.0 the SDK asks for, so the monorepo compiles with one compiler. Nothing here needs 6: `tsc --noEmit` passes, and this app is a WebView with almost no type surface. Revisit when the rest of the repo moves.",
      "exclude": [
        "typescript"
      ]
    }
  },
  "scripts": {
    "dev": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@formatjs/intl-getcanonicallocales": "^3.2.11",
    "@formatjs/intl-locale": "^5.3.10",
    "@formatjs/intl-pluralrules": "^6.3.13",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "@repo/catalog": "workspace:*",
    "@repo/messages": "workspace:*",
    "@shopify/flash-list": "2.0.2",
    "babel-preset-expo": "~57.0.6",
    "expo": "~57.0.12",
    "expo-build-properties": "~57.0.10",
    "expo-constants": "~57.0.10",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-localization": "~57.0.1",
    "expo-screen-orientation": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.13",
    "intl-messageformat": "^11.2.13",
    "lucide-react-native": "^1.31.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3"
  }
}
