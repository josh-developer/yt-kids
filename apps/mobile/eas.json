{
  "cli": {
    "version": ">= 21.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "REACT_NATIVE_NODE_MODULES_DIR": "./node_modules"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "REACT_NATIVE_NODE_MODULES_DIR": "./node_modules"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "NODE_ENV": "production",
        "REACT_NATIVE_NODE_MODULES_DIR": "./node_modules"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-apk": {
      "channel": "production",
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a"
      },
      "env": {
        "REACT_NATIVE_NODE_MODULES_DIR": "./node_modules"
      }
    },
    "preview-tv": {
      "distribution": "internal",
      "channel": "preview-tv",
      "env": {
        "EXPO_TV": "1",
        "REACT_NATIVE_NODE_MODULES_DIR": "./node_modules"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production-tv": {
      "channel": "production-tv",
      "autoIncrement": true,
      "env": {
        "NODE_ENV": "production",
        "EXPO_TV": "1",
        "REACT_NATIVE_NODE_MODULES_DIR": "./node_modules"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-tv-apk": {
      "channel": "production-tv",
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "NODE_ENV": "production",
        "EXPO_TV": "1",
        "REACT_NATIVE_NODE_MODULES_DIR": "./node_modules"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a,armeabi-v7a"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
