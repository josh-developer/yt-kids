{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Expo",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],
    "target": "ESNext",
    "lib": ["DOM", "ESNext"],
    "jsx": "react-jsx",
    "allowJs": true,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  },
  "exclude": ["node_modules"]
}
